<?xml version="1.0" encoding="utf-8"?>
<!-- Sıradaki 2×2 (F5.1, §3.4): "SIRADAKİ" 11sp · saat 28sp tabular · başlık 14sp
     2 satır · "+N daha" · 40×40 "+". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/widget_next_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding">

        <TextView
            android:id="@+id/widget_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_next_label"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_next_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_empty_today"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_notifications_off"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_strip_bg"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:maxLines="2"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/widget_notifications_off"
            android:textColor="@color/widget_on_pill"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_next_more"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/widget_add"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_pill_round"
                android:clickable="true"
                android:contentDescription="@string/widget_cd_add"
                android:focusable="true"
                android:scaleType="center"
                android:src="@drawable/widget_ic_add" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
