  "fixed_sql": [
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"note\" TEXT NULL, \"is_done\" INTEGER NOT NULL CHECK (\"is_done\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"remind_at\" TEXT NULL, \"category_id\" TEXT NOT NULL, \"custom_category_label\" TEXT NULL, \"location_trigger_enabled\" INTEGER NOT NULL CHECK (\"location_trigger_enabled\" IN (0, 1)), \"location_latitude\" REAL NULL, \"location_longitude\" REAL NULL, \"location_radius_meters\" REAL NOT NULL, \"location_place_label\" TEXT NULL, \"position\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"recurrence\" TEXT NULL, \"priority\" INTEGER NOT NULL DEFAULT 0, \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "subtasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subtasks\" (\"reminder_id\" TEXT NOT NULL REFERENCES reminders (id), \"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"is_done\" INTEGER NOT NULL CHECK (\"is_done\" IN (0, 1)), \"position\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"reminder_id\", \"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color_key\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "birthdays",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"birthdays\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"note\" TEXT NULL, \"birth_month\" INTEGER NOT NULL, \"birth_day\" INTEGER NOT NULL, \"birth_year\" INTEGER NULL, \"notify_hour\" INTEGER NOT NULL, \"notify_minute\" INTEGER NOT NULL, \"advance_offsets_minutes\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL, \"notifications_enabled\" INTEGER NOT NULL CHECK (\"notifications_enabled\" IN (0, 1)), \"theme_mode\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_meta\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
